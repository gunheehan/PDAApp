@page "/scan"
@using PDAApp.Services
@inject ScannerService Scanner

<div class="scan-page">
    <div class="content">
        <h2>바코드 스캔</h2>

        @if (!string.IsNullOrEmpty(scannedBarcode))
        {
        <div class="result-box">
            <h4>✓ 스캔 결과</h4>
            <div class="barcode-value">@scannedBarcode</div>
            <button class="btn-secondary" @onclick="ClearResult">
                결과 지우기
            </button>
        </div>
        }

        <button class="btn-scan" @onclick="StartScan" disabled="@isScanning">
            @if (isScanning)
            {
            <span>스캔 중...</span>
            }
            else
            {
            <span>📷 스캔 시작</span>
            }
        </button>

        <div class="info">
            <p>버튼을 누르면 카메라 화면이 열립니다</p>
            <p>바코드를 카메라에 비추면 자동으로 인식됩니다</p>
        </div>
    </div>
</div>