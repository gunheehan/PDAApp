@page "/scan"
@using Microsoft.Maui.ApplicationModel
@using ZXing.Net.Maui

<div class="scan-container">
    <h3>바코드 스캔</h3>

    @if (!string.IsNullOrEmpty(scannedBarcode))
    {
        <div class="result-box">
            <h4>스캔 결과:</h4>
            <p>@scannedBarcode</p>
            <button class="btn btn-primary" @onclick="ResetScan">다시 스캔</button>
        </div>
    }
    else
    {
        <div class="camera-view">
            <CameraBarcodeReaderView 
                @ref="cameraBarcodeReaderView"
                OnDetected="OnBarcodeDetected"
                IsDetecting="isDetecting"
                BarCodeOptions="barcodeOptions" />
        </div>
        
        <div class="controls">
            <button class="btn btn-success" @onclick="StartScanning">스캔 시작</button>
            <button class="btn btn-danger" @onclick="StopScanning">스캔 중지</button>
        </div>
    }
</div>

@code {
    private ElementReference cameraBarcodeReaderView;
    private string? scannedBarcode;
    private bool isDetecting = false;
    
    private BarcodeReaderOptions barcodeOptions = new BarcodeReaderOptions
    {
        Formats = BarcodeFormats.All,
        AutoRotate = true,
        Multiple = false
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckCameraPermission();
        }
    }

    private async Task CheckCameraPermission()
    {
        var status = await Permissions.CheckStatusAsync<Permissions.Camera>();
        
        if (status != PermissionStatus.Granted)
        {
            status = await Permissions.RequestAsync<Permissions.Camera>();
        }

        if (status == PermissionStatus.Granted)
        {
            isDetecting = true;
            StateHasChanged();
        }
    }

    private void OnBarcodeDetected(BarcodeDetectionEventArgs e)
    {
        if (e.Results?.Length > 0)
        {
            var result = e.Results[0];
            scannedBarcode = result.Value;
            isDetecting = false;
            
            MainThread.BeginInvokeOnMainThread(() =>
            {
                StateHasChanged();
            });
        }
    }

    private void StartScanning()
    {
        scannedBarcode = null;
        isDetecting = true;
        StateHasChanged();
    }

    private void StopScanning()
    {
        isDetecting = false;
        StateHasChanged();
    }

    private void ResetScan()
    {
        scannedBarcode = null;
        isDetecting = true;
        StateHasChanged();
    }
}